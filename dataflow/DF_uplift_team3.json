{
	"name": "DF_uplift_team3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "bronzelocation",
					"rejectedDataLinkedService": {
						"referenceName": "LS_BLOB",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "selectcolumns"
				},
				{
					"name": "nullhandling"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Carrier Code} as long,",
				"          {Ticket Number} as long,",
				"          {Coupon Number} as long,",
				"          {Flight no} as long,",
				"          {Flight Date} as date,",
				"          {Class of Travel} as string,",
				"          {From Airport} as string,",
				"          {To Airport} as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * \\r\\nfrom Uplift\\r\\nwhere [Ticket Number] \\r\\nin ( \\r\\nselect [Ticket Number] from sales \\r\\ngroup by [Ticket Number] \\r\\nhaving count(*) =1 \\r\\n) \\r\\nand [Carrier Code] = 888',",
				"     format: 'query') ~> source1",
				"source1 select(mapColumn(",
				"          {Carrier Code},",
				"          {Ticket Number},",
				"          {Coupon Number},",
				"          {Flight no},",
				"          {Flight Date},",
				"          {Class of Travel},",
				"          {From Airport},",
				"          {To Airport}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectcolumns",
				"selectcolumns derive(each(match(type=='string'), $$ = coalesce($$, 'Unknown')),",
				"          each(match(type == 'double'), $$ = coalesce($$, 0.0)),",
				"          each(match(type == 'long'), $$ = coalesce($$, 0)),",
				"          each(match(type == 'integer'), $$ = coalesce($$, 0)),",
				"          each(match(type == 'date'), $$ = coalesce($$, '1900-01-01'))) ~> nullhandling",
				"nullhandling sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['uplift.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     outputAssertFailedRows: true,",
				"     partitionBy('hash', 1)) ~> bronzelocation"
			]
		}
	}
}