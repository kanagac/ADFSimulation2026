{
	"name": "DF_DocumentType",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_Server_StarAir",
						"type": "DatasetReference"
					},
					"name": "SourceDocumentType"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DF_Tgt_Blob_StarAir",
						"type": "DatasetReference"
					},
					"name": "TargetDocumentType"
				}
			],
			"transformations": [
				{
					"name": "DerivedColumnDocumentType"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Document Type} as string,",
				"          Description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceDocumentType",
				"SourceDocumentType derive(each(match(type=='string'), $$ = iif(isNull($$), toString('UNK'), toString($$))),",
				"          each(match(type=='int'), $$ = coalesce($$,toInteger(0)))) ~> DerivedColumnDocumentType",
				"DerivedColumnDocumentType sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TargetDocumentType"
			]
		}
	}
}