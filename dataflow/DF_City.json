{
	"name": "DF_City",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TABLE",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {City Code } as string,",
				"          {City Name} as string,",
				"          {Country Code} as string,",
				"          {Lookup Value} as string,",
				"          {Country Number} as string,",
				"          {Country Name} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive({City Code } = coalesce({City Code },'NA'),",
				"          {City Name} = coalesce({City Name},'NA'),",
				"          {Country Code} = coalesce({Country Code},'NA'),",
				"          {Lookup Value} = coalesce({Lookup Value},'0'),",
				"          {Country Number} = coalesce({Country Number},'0'),",
				"          {Country Name} = coalesce({Country Name},'NA')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}