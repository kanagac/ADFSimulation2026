{
	"name": "DF_Airport",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TABLE",
						"type": "DatasetReference"
					},
					"name": "source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "cleansing"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source",
				"source derive({SL NO} = toInteger(coalesce({SL NO}, '0'))\r",
				"\r",
				"\r",
				",",
				"          {Airport Code} = coalesce({Airport Code},'NA'),",
				"          {Airport Name} = coalesce({Airport Name},'NA'),",
				"          {City Code} = coalesce({City Code},'NA'),",
				"          Country = coalesce(Country,'NA'),",
				"          {Country Code} = coalesce({Country Code},'NA'),",
				"          {Country Name} = coalesce({Country Name},'NA')) ~> cleansing",
				"cleansing sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {SL NO},",
				"          {Airport Code},",
				"          {Airport Name},",
				"          {City Code},",
				"          Country,",
				"          {Country Code},",
				"          {Country Name}",
				"     )) ~> sink"
			]
		}
	}
}