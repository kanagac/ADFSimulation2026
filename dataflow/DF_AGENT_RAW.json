{
	"name": "DF_AGENT_RAW",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_SERVER",
						"type": "DatasetReference"
					},
					"name": "Source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "Stage"
				}
			],
			"transformations": [
				{
					"name": "Cleansing"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Agent Code} as string,",
				"          {Agent Name} as string,",
				"          {Agent Address} as string,",
				"          {Agent City} as string,",
				"          {Location Type} as string,",
				"          {Ctrl location} as string,",
				"          country as string,",
				"          City as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Source",
				"Source derive({Agent Code} = iif(\r",
				"    isNull({Agent Code}) || trim({Agent Code}) == '',\r",
				"    'NA',\r",
				"    {Agent Code}\r",
				"),",
				"          {Agent Name} = iif(\r",
				"    isNull({Agent Name}) || trim({Agent Name}) == '',\r",
				"    'NA',\r",
				"    {Agent Name}\r",
				"),",
				"          {Agent Address} = iif(\r",
				"    isNull({Agent Address}) || trim({Agent Address}) == '',\r",
				"    'NA',\r",
				"    {Agent Address}\r",
				"),",
				"          {Agent City} = iif(\r",
				"    isNull({Agent City}) || trim({Agent City}) == '',\r",
				"    'NA',\r",
				"    {Agent City}\r",
				"),",
				"          {Location Type} = iif(\r",
				"    isNull({Location Type}) || trim({Location Type}) == '',\r",
				"    'NA',\r",
				"    {Location Type}\r",
				"),",
				"          {Ctrl location} = iif(\r",
				"    isNull({Ctrl location}) || trim({Ctrl location}) == '',\r",
				"    'NA',\r",
				"    {Ctrl location}\r",
				"),",
				"          country = iif(\r",
				"    isNull({country}) || trim({country}) == '',\r",
				"    'NA',\r",
				"    {country}\r",
				"),",
				"          City = iif(\r",
				"    isNull({City}) || trim({City}) == '',\r",
				"    'NA',\r",
				"    {City}\r",
				")) ~> Cleansing",
				"Cleansing sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> Stage"
			]
		}
	}
}