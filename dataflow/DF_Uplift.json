{
	"name": "DF_Uplift",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_Server_StarAir",
						"type": "DatasetReference"
					},
					"name": "SourceUplift"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DF_Tgt_Blob_StarAir",
						"type": "DatasetReference"
					},
					"name": "TargetUplift"
				}
			],
			"transformations": [
				{
					"name": "DerivedColumnUplift"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Carrier Code} as long,",
				"          {Ticket Number} as long,",
				"          {Coupon Number} as long,",
				"          {Flight no} as long,",
				"          {Flight Date} as date,",
				"          {Class of Travel} as string,",
				"          {From Airport} as string,",
				"          {To Airport} as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceUplift",
				"SourceUplift derive(each(match(type=='string'), $$ = iif(isNull($$), toString('UNK'), toString($$))),",
				"          each(match(type=='int'), $$ = coalesce($$,toInteger(0)))) ~> DerivedColumnUplift",
				"DerivedColumnUplift sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TargetUplift"
			]
		}
	}
}