{
	"name": "DF_Sales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TABLE",
						"type": "DatasetReference"
					},
					"name": "source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Carrier Code} as long,",
				"          {Ticket Number} as long,",
				"          {Sales Currency} as string,",
				"          {Ticket Amount} as long,",
				"          {Agent Code} as long,",
				"          {Agent City Code} as string,",
				"          {Sale Date} as date,",
				"          {Commission Amount} as double,",
				"          {Discount Amount} as long,",
				"          {TAX Amount} as double,",
				"          {Tax Code 1} as string,",
				"          {Tax 1 Amount} as double,",
				"          {Tax code 2} as string,",
				"          {Tax 2 Amount} as double,",
				"          {Tax Code 3} as string,",
				"          {Tax 3 Amount} as double,",
				"          {FOP 1 Code} as string,",
				"          {FOP 1 Amount} as double,",
				"          {FOP 2} as string,",
				"          {FOP 2 Amount} as double,",
				"          {FOP 3} as string,",
				"          {FOP 3 Amount} as double,",
				"          {Flight year Quarter} as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from Sales \\n\\nwhere [Ticket Number] in \\n\\n( \\n\\nselect [Ticket Number] from sales \\n\\ngroup by [Ticket Number] \\n\\nhaving count(*) =1 \\n\\n) ',",
				"     format: 'query') ~> source",
				"source derive({Carrier Code} = coalesce({Carrier Code},0),",
				"          {Ticket Number} = coalesce({Ticket Number},0),",
				"          {Sales Currency} = coalesce({Sales Currency},'NA'),",
				"          {Ticket Amount} = coalesce({Ticket Amount}),",
				"          {Agent Code} = coalesce({Agent Code},0),",
				"          {Agent City Code} = coalesce({Agent City Code},'NA'),",
				"          {Sale Date} = coalesce({Sale Date},toDate('1990-01-01'))  ,",
				"          {Commission Amount} = coalesce({Commission Amount},0),",
				"          {Discount Amount} = coalesce({Discount Amount},0),",
				"          {TAX Amount} = coalesce({TAX Amount},0),",
				"          {Tax Code 1} = coalesce({Tax Code 1},'NA'),",
				"          {Tax 1 Amount} = coalesce({Tax 1 Amount},0),",
				"          {Tax code 2} = coalesce({Tax code 2},'NA'),",
				"          {Tax 2 Amount} = coalesce({Tax 2 Amount},0),",
				"          {Tax Code 3} = coalesce({Tax Code 3},'NA'),",
				"          {Tax 3 Amount} = coalesce({Tax 3 Amount},0),",
				"          {FOP 1 Code} = coalesce({FOP 1 Code},'NA'),",
				"          {FOP 1 Amount} = coalesce({FOP 1 Amount},0),",
				"          {FOP 2} = coalesce({FOP 2},'NA'),",
				"          {FOP 2 Amount} = coalesce({FOP 2 Amount},0),",
				"          {FOP 3} = coalesce({FOP 3},'NA'),",
				"          {FOP 3 Amount} = coalesce({FOP 3 Amount},0),",
				"          {Flight year Quarter} = coalesce({Flight year Quarter},'NA')) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {Carrier Code},",
				"          {Ticket Number},",
				"          {Sales Currency},",
				"          {Ticket Amount},",
				"          {Agent Code},",
				"          {Agent City Code},",
				"          {Sale Date},",
				"          {Commission Amount},",
				"          {Discount Amount},",
				"          {TAX Amount},",
				"          {Tax Code 1},",
				"          {Tax 1 Amount},",
				"          {Tax code 2},",
				"          {Tax 2 Amount},",
				"          {Tax Code 3},",
				"          {Tax 3 Amount},",
				"          {FOP 1 Code},",
				"          {FOP 1 Amount},",
				"          {FOP 2},",
				"          {FOP 2 Amount},",
				"          {FOP 3},",
				"          {FOP 3 Amount},",
				"          {Flight year Quarter}",
				"     )) ~> sink1"
			]
		}
	}
}