{
	"name": "DF_Sales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TABLE",
						"type": "DatasetReference"
					},
					"name": "source"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Carrier Code} as long,",
				"          {Ticket Number} as long,",
				"          {Sales Currency} as string,",
				"          {Ticket Amount} as long,",
				"          {Agent Code} as long,",
				"          {Agent City Code} as string,",
				"          {Sale Date} as date,",
				"          {Commission Amount} as double,",
				"          {Discount Amount} as long,",
				"          {TAX Amount} as double,",
				"          {Tax Code 1} as string,",
				"          {Tax 1 Amount} as double,",
				"          {Tax code 2} as string,",
				"          {Tax 2 Amount} as double,",
				"          {Tax Code 3} as string,",
				"          {Tax 3 Amount} as double,",
				"          {FOP 1 Code} as string,",
				"          {FOP 1 Amount} as double,",
				"          {FOP 2} as string,",
				"          {FOP 2 Amount} as double,",
				"          {FOP 3} as string,",
				"          {FOP 3 Amount} as double,",
				"          {Flight year Quarter} as string,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from Sales \\n\\nwhere [Ticket Number] in \\n\\n( \\n\\nselect [Ticket Number] from sales \\n\\ngroup by [Ticket Number] \\n\\nhaving count(*) =1 \\n\\n) ',",
				"     format: 'query') ~> source",
				"source derive({Carrier Code} = coalesce({Carrier Code},0),",
				"          {Ticket Number} = coalesce({Ticket Number},0),",
				"          {Sales Currency} = coalesce({Sales Currency},'NA'),",
				"          {Ticket Amount} = coalesce({Ticket Amount}),",
				"          column5 = ERROR_FUNCTION(''),",
				"          column6 = ERROR_FUNCTION(''),",
				"          column7 = ERROR_FUNCTION(''),",
				"          column8 = ERROR_FUNCTION(''),",
				"          column9 = ERROR_FUNCTION(''),",
				"          column10 = ERROR_FUNCTION(''),",
				"          column11 = ERROR_FUNCTION('')) ~> derivedColumn1"
			]
		}
	}
}