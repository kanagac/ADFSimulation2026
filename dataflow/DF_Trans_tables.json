{
	"name": "DF_Trans_tables",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TransacTB",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Trans_Tables",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Airline No.} as long,",
				"          {Ticket No.} as long,",
				"          {Country Code} as string,",
				"          {Sale Currency Code} as string,",
				"          {Sale Valu} as long,",
				"          {Billing Currency Code} as string,",
				"          {Billing Value} as long,",
				"          {Card Type} as string,",
				"          {Invoice No.} as string,",
				"          {Invoice Date} as timestamp,",
				"          {Sale/Refund} as string,",
				"          {Chargeback Date} as date,",
				"          {Chargeback Amt} as double,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from [dbo].[CCDSettlement] \\n\\nwhere [Ticket No.] \\n\\nin  \\n\\n( \\n\\n select [Ticket Number] from sales \\n\\ngroup by [Ticket Number] \\n\\nhaving count(*) =1 \\n\\n) ',",
				"     format: 'query') ~> source1",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$),'N/A',$$)),",
				"          each(match(type=='integer'), $$ = coalesce($$,toInteger(0)))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {Airline No.},",
				"          {Ticket No.},",
				"          {Country Code},",
				"          {Sale Currency Code},",
				"          {Sale Valu},",
				"          {Billing Currency Code},",
				"          {Billing Value},",
				"          {Card Type},",
				"          {Invoice No.},",
				"          {Invoice Date},",
				"          {Sale/Refund},",
				"          {Chargeback Date},",
				"          {Chargeback Amt},",
				"          IsActive",
				"     )) ~> sink1"
			]
		}
	}
}