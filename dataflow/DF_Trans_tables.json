{
	"name": "DF_Trans_tables",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TransacTB",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Trans_Tables",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Billed Carrier code} as long,",
				"          {Carrier code} as long,",
				"          {Ticket no} as long,",
				"          {Coupon no} as long,",
				"          {Billed date} as date,",
				"          Stage as long,",
				"          {Billed currency} as string,",
				"          {Billed coupon amount} as long,",
				"          {Billed commission amount} as double,",
				"          {Billed discount amout} as long,",
				"          {Accepted coupon amount} as double,",
				"          {Accepted Comission amount} as double,",
				"          {Accepted discount amount} as double,",
				"          {Rejected coupon amount} as double,",
				"          {Rejected commission amount} as double,",
				"          {Rejected discount amount} as double,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from inward \\n\\nwhere [Ticket no] \\n\\nin  \\n\\n( \\n\\nselect [Ticket Number] from sales \\n\\ngroup by [Ticket Number] \\n\\nhaving count(*) =1 \\n\\n) \\n',",
				"     format: 'query') ~> source1",
				"source1 derive(each(match(type=='string'), $$ = iif(isNull($$),'N/A',$$)),",
				"          each(match(type=='integer'), $$ = coalesce($$,toInteger(0)))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {Billed Carrier code},",
				"          {Carrier code},",
				"          {Ticket no},",
				"          {Coupon no},",
				"          {Billed date},",
				"          Stage,",
				"          {Billed currency},",
				"          {Billed coupon amount},",
				"          {Billed commission amount},",
				"          {Billed discount amout},",
				"          {Accepted coupon amount},",
				"          {Accepted Comission amount},",
				"          {Accepted discount amount},",
				"          {Rejected coupon amount},",
				"          {Rejected commission amount},",
				"          {Rejected discount amount},",
				"          IsActive",
				"     )) ~> sink1"
			]
		}
	}
}