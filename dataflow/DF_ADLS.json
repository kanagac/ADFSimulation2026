{
	"name": "DF_ADLS",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SOURCE_IN1733",
						"type": "DatasetReference"
					},
					"name": "SourceCurrency"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_TARGET_IN1733",
						"type": "DatasetReference"
					},
					"name": "TargetCurrency"
				}
			],
			"transformations": [
				{
					"name": "TransformatioNullhandling"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Currency Code} as string,",
				"          Description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceCurrency",
				"SourceCurrency derive(each(match(type == 'integer'), $$ = coalesce($$,toInteger(0))),",
				"          each(match(type == 'string'), $$ = iif(isNull($$), toString('NA'), toString($$)))) ~> TransformatioNullhandling",
				"TransformatioNullhandling sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TargetCurrency"
			]
		}
	}
}