{
	"name": "DF_Common",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_TABLE",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_CSV",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "cleansing"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Airline No.} as long,",
				"          {Ticket No.} as long,",
				"          {Country Code} as string,",
				"          {Sale Currency Code} as string,",
				"          {Sale Valu} as long,",
				"          {Billing Currency Code} as string,",
				"          {Billing Value} as long,",
				"          {Card Type} as string,",
				"          {Invoice No.} as string,",
				"          {Invoice Date} as timestamp,",
				"          {Sale/Refund} as string,",
				"          {Chargeback Date} as double,",
				"          {Chargeback Amt} as double,",
				"          IsActive as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from [dbo].[CCDSettlement] \\n\\nwhere [Ticket No.] \\n\\nin  \\n\\n( \\n\\n select [Ticket Number] from sales \\n\\ngroup by [Ticket Number] \\n\\nhaving count(*) =1 \\n\\n) ',",
				"     format: 'query') ~> source1",
				"source1 derive(each(match(type == 'string'), $$ = coalesce($$,'NA')),",
				"          each(match(type == 'Integer'), $$ = coalesce($$, 0)),",
				"          each(match(type == 'date'), $$ = coalesce($$,toDate('1990-01-01')))) ~> cleansing",
				"cleansing sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {Airline no} = {Airline No.},",
				"          {Ticket no} = {Ticket No.},",
				"          {Country Code},",
				"          {Sale Currency Code},",
				"          {Sale Valu},",
				"          {Billing Currency Code},",
				"          {Billing Value},",
				"          {Card Type},",
				"          {Invoice no} = {Invoice No.},",
				"          {Invoice Date},",
				"          {Sale/Refund},",
				"          {Chargeback Date},",
				"          {Chargeback Amt}",
				"     )) ~> sink1"
			]
		}
	}
}