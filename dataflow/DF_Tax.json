{
	"name": "DF_Tax",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_SQL_Server_StarAir",
						"type": "DatasetReference"
					},
					"name": "SourceTax"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DF_Tgt_Blob_StarAir",
						"type": "DatasetReference"
					},
					"name": "TargetTax"
				}
			],
			"transformations": [
				{
					"name": "DerivedColumnTax"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Tax Code} as string,",
				"          Description as string,",
				"          {Country Code} as string,",
				"          Type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceTax",
				"SourceTax derive(each(match(type=='string'), $$ = iif(isNull($$), toString('UNK'), toString($$))),",
				"          each(match(type=='int'), $$ = coalesce($$,toInteger(0)))) ~> DerivedColumnTax",
				"DerivedColumnTax sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> TargetTax"
			]
		}
	}
}